    {
      "name": "Popup Card",
      "kind": "card",
      "refersTo": "popup-card",
      "description": "Every popup: filter row, then up to 16 rows.",
      "html": "<div class=\"ds-popup\"><div class=\"ds-popup-filter\">ma</div><div class=\"ds-popup-row ds-sel\">Mode <u>Ma</u>rkdown</div><div class=\"ds-popup-row\">Toggle <u>Ma</u>th</div><div class=\"ds-popup-row\">For<u>ma</u>t Table</div></div>",
      "css": "font-family:-apple-system,system-ui,sans-serif;.ds-popup{font-family:-apple-system,system-ui,sans-serif;width:360px;background:#FAFAFA;border-radius:6px;padding-bottom:12px;box-shadow:0 0 0 1px rgba(0,0,0,0.1),0 0 0 8px rgba(0,0,0,0.025)}.ds-popup-filter{font-size:26px;font-weight:300;height:72px;line-height:72px;padding:0 20px;color:#4C4C4C}.ds-popup-row{font-size:13px;height:24px;line-height:24px;padding:0 20px;color:#7F7F7F;cursor:default}.ds-popup-row:hover{background:rgba(204,204,204,0.25)}.ds-popup-row.ds-sel{background:rgba(71,153,235,0.25)}"
    },
    {
      "name": "Popup Filter",
      "kind": "input",
      "refersTo": "popup-filter",
      "description": "The large light query field at the top of a popup.",
      "html": "<input class=\"ds-filter\" placeholder=\"Go to File\">",
      "css": ".ds-filter{font-family:-apple-system,system-ui,sans-serif;width:360px;font-size:26px;font-weight:300;height:72px;padding:0 20px;border:none;background:#FAFAFA;color:#4C4C4C;outline:none;border-radius:6px}.ds-filter::placeholder{color:#B3B3B3}.ds-filter:focus-visible{box-shadow:0 0 0 1px rgba(0,0,0,0.1)}"
    },
    {
      "name": "Tab Strip",
      "kind": "nav",
      "refersTo": "tab",
      "description": "Text-only tabs in the 48 pt strip; current tab one grey darker.",
      "html": "<div class=\"ds-tabs\"><span class=\"ds-tab ds-cur\">Welcome<span class=\"ds-ext\">.md</span></span><span class=\"ds-tab\">Notes<span class=\"ds-ext\">.md</span> •</span><span class=\"ds-tab\">⇾ todo<span class=\"ds-ext\">.md</span></span></div>",
      "css": ".ds-tabs{font-family:-apple-system,system-ui,sans-serif;display:flex;justify-content:center;height:48px;padding:9px 80px 0;background:#FAFAFA}.ds-tab{font-size:13px;height:30px;line-height:24px;padding:3px 10px;max-width:200px;color:#B3B3B3;cursor:default;white-space:nowrap}.ds-tab:hover{color:#7F7F7F}.ds-tab.ds-cur{color:#7F7F7F}.ds-ext{color:#B3B3B3}"
    },
    {
      "name": "Notification Bar",
      "kind": "custom",
      "refersTo": "notification-bar",
