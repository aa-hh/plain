      "css": ".ds-note{font-family:-apple-system,system-ui,sans-serif;font-size:13px;color:#8599AE;background:#FAFAFA;border-top:1px solid #8599AE;padding:13px;text-align:center}.ds-bracket{font:inherit;color:inherit;background:none;border:none;padding:0 0 0 13px;cursor:pointer}.ds-bracket:hover{color:#4C4C4C}.ds-bracket:focus-visible{outline:1px solid rgba(0,0,0,0.1)}"
    },
